{
  "version": "3.10.0-dev.1",
  "packages": [
    "packages/*"
  ],
  "npmClient": "npm",
  "npmClientArgs": [
    "--no-audit",
    "--no-fund",
    "--prefer-offline",
    "--progress=false",
    "--loglevel=warn",
    "--maxsockets=1",
    "--fetch-retries=3",
    "--fetch-timeout=300000"
  ],
  "concurrency": 2,
  "stream": false
}
