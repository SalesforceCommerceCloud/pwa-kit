# Use public npm registry
registry=https://registry.npmjs.org/

# Override any internal Salesforce registries
@salesforce:registry=https://registry.npmjs.org/
@adyen:registry=https://registry.npmjs.org/

# Optimize for lower memory and CPU usage
maxsockets=5
fetch-retries=1
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
progress=false
loglevel=warn

# Use npm cache more efficiently
cache-min=3600
prefer-offline=true

# Reduce network requests
audit=false
fund=false

# Optimize for monorepo
workspaces-update=false 