{
  "description": "Configuration for synchronizing template-retail-react-app source files with .hbs templates",
  "mappings": [
    {
      "source": "app/ssr.js",
      "targets": [
        {
          "templateDir": "retail",
          "destination": "app/ssr.js.hbs"
        },
        {
          "templateDir": "bootstrap",
          "destination": "overrides/app/ssr.js.hbs"
        }
      ],
      "transformations": [
        {
          "type": "replace",
          "pattern": "useSLASPrivateClient: false",
          "replacement": "useSLASPrivateClient: {{answers.project.commerce.isSlasPrivate}}"
        },
        {
          "type": "conditional_replace",
          "pattern": "app\\.use\\(\\s*helmet\\(\\{[\\s\\S]*?contentSecurityPolicy:\\s*\\{[\\s\\S]*?\\}[\\s\\S]*?\\}\\)\\s*\\)",
          "replacement": "{{#if answers.project.contentSecurityPolicy}}\n    const contentSecurityPolicy = {{{json answers.project.contentSecurityPolicy}}}\n    {{else}}\n    const contentSecurityPolicy = {\n        useDefaults: true,\n        directives: {\n            'img-src': [\n                // Default source for product images - replace with your CDN\n                '*.commercecloud.salesforce.com',\n                '*.demandware.net'\n            ],\n            'script-src': [\n                // Used by the service worker in /worker/main.js\n                'storage.googleapis.com'\n            ],\n            'connect-src': [\n                // Connect to Einstein APIs\n                'api.cquotient.com',\n                // Connect to DataCloud APIs\n                '*.c360a.salesforce.com',\n                // Connect to SCRT2 URLs\n                '*.salesforce-scrt.com'\n            ],\n            'frame-src': [\n                // Allow frames from Salesforce site.com (Needed for MIAW)\n                '*.site.com'\n            ]\n        }\n    }\n    {{/if}}\n\n    app.use(\n        helmet({\n            contentSecurityPolicy\n        })\n    )"
        }
      ]
    },
    {
      "source": "config/default.js",
      "targets": [
        {
          "templateDir": "retail",
          "destination": "config/default.js.hbs"
        },
        {
          "templateDir": "bootstrap",
          "destination": "config/default.js.hbs"
        }
      ],
      "transformations": [
        {
          "type": "replace",
          "pattern": "partialHydrationEnabled: false",
          "replacement": "{{#if answers.project.partialHydrationEnabled}}\n        partialHydrationEnabled: {{answers.project.partialHydrationEnabled}},\n        {{else}}\n        partialHydrationEnabled: false,\n        {{/if}}"
        },
        {
          "type": "replace",
          "pattern": "site: 'path'",
          "replacement": "{{#if answers.project.demo.enableDemoSettings}}\n            site: 'path',\n            {{else}}\n            site: 'none',\n            {{/if}}"
        },
        {
          "type": "replace",
          "pattern": "locale: 'path'",
          "replacement": "{{#if answers.project.demo.enableDemoSettings}}\n            locale: 'path',\n            {{else}}\n            locale: 'none',\n            {{/if}}"
        },
        {
          "type": "replace",
          "pattern": "showDefaults: true",
          "replacement": "{{#if answers.project.demo.enableDemoSettings}}\n            showDefaults: true,\n            {{else}}\n            showDefaults: false,\n            {{/if}}"
        },
        {
          "type": "replace",
          "pattern": "enabled: false",
          "replacement": "{{#if answers.project.demo.enableDemoSettings}}\n                enabled: true,\n                {{else}}\n                enabled: false,\n                {{/if}}"
        },
        {
          "type": "replace",
          "pattern": "defaultSite: 'RefArchGlobal'",
          "replacement": "defaultSite: '{{answers.project.commerce.siteId}}'"
        },
        {
          "type": "replace",
          "pattern": "siteAliases: \\{[\\s\\S]*?\\}",
          "replacement": "{{#if answers.project.demo.enableDemoSettings}}\n        siteAliases: {\n            RefArch: 'us',\n            RefArchGlobal: 'global'\n        },\n        {{else}}\n        // siteAliases: {\n        //    RefArch: 'us',\n        //    RefArchGlobal: 'global'\n        // },\n        {{/if}}"
        },
        {
          "type": "replace",
          "pattern": "clientId: 'c9c45bfd-0ed3-4aa2-9971-40f88962b836'",
          "replacement": "clientId: '{{answers.project.commerce.clientId}}'"
        },
        {
          "type": "replace",
          "pattern": "organizationId: 'f_ecom_zzrf_001'",
          "replacement": "organizationId: '{{answers.project.commerce.organizationId}}'"
        },
        {
          "type": "replace",
          "pattern": "shortCode: '8o7m175y'",
          "replacement": "shortCode: '{{answers.project.commerce.shortCode}}'"
        },
        {
          "type": "replace",
          "pattern": "siteId: 'RefArchGlobal'",
          "replacement": "siteId: '{{answers.project.commerce.siteId}}'"
        },
        {
          "type": "replace",
          "pattern": "einsteinId: '1ea06c6e-c936-4324-bcf0-fada93f83bb1'",
          "replacement": "einsteinId: '{{answers.project.einstein.clientId}}'"
        },
        {
          "type": "replace",
          "pattern": "siteId: 'aaij-MobileFirst'",
          "replacement": "siteId: '{{answers.project.einstein.siteId}}'"
        },
        {
          "type": "replace",
          "pattern": "appSourceId: '7ae070a6-f4ec-4def-a383-d9cacc3f20a1'",
          "replacement": "appSourceId: '{{answers.project.dataCloud.appSourceId}}'"
        },
        {
          "type": "replace",
          "pattern": "tenantId: 'g82wgnrvm-ywk9dggrrw8mtggy.pc-rnd'",
          "replacement": "tenantId: '{{answers.project.dataCloud.tenantId}}'"
        },
        {
          "type": "replace",
          "pattern": "host: 'kv7kzm78.api.commercecloud.salesforce.com'",
          "replacement": "host: '{{answers.project.commerce.shortCode}}.api.commercecloud.salesforce.com'"
        },
        {
          "type": "replace",
          "pattern": "host: 'zzrf-001.dx.commercecloud.salesforce.com'",
          "replacement": "{{~#if answers.project.commerce.instanceUrl}},\n            {\n                host: '{{answers.project.commerce.instanceUrl}}',\n                path: 'ocapi'\n            }{{/if}}"
        }
      ]
    },
    {
      "source": "config/sites.js",
      "targets": [
        {
          "templateDir": "retail",
          "destination": "config/sites.js.hbs"
        },
        {
          "templateDir": "bootstrap",
          "destination": "config/sites.js.hbs"
        }
      ],
      "transformations": []
    },
    {
      "source": "config/utils.js",
      "targets": [
        {
          "templateDir": "retail",
          "destination": "config/utils.js.hbs"
        },
        {
          "templateDir": "bootstrap",
          "destination": "config/utils.js.hbs"
        }
      ],
      "transformations": []
    },
    {
      "source": "app/static/manifest.json",
      "targets": [
        {
          "templateDir": "retail",
          "destination": "app/static/manifest.json.hbs"
        },
        {
          "templateDir": "bootstrap",
          "destination": "overrides/app/static/manifest.json.hbs"
        }
      ],
      "transformations": [
        {
          "type": "replace",
          "pattern": "\"name\": \"Retail React App\"",
          "replacement": "\"name\": \"{{answers.project.name}}\""
        },
        {
          "type": "replace",
          "pattern": "\"short_name\": \"Retail React App\"",
          "replacement": "\"short_name\": \"{{answers.project.name}}\""
        }
      ]
    },
    {
      "source": "app/components/_app-config/index.jsx",
      "targets": [
        {
          "templateDir": "retail",
          "destination": "app/components/_app-config/index.jsx.hbs"
        },
        {
          "templateDir": "bootstrap",
          "destination": "overrides/app/components/_app-config/index.jsx.hbs"
        }
      ],
      "transformations": []
    }
  ]
}
