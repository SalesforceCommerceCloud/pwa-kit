React 18

1.  Functional Components with Hooks and follow single responsibility principle

✅ Use functional components exclusively

// Good: One purpose per component
const QuantityPicker = ({ value, onChange, min = 1, max = 10 }) => {
    // Only handles quantity selection logic
}

const AddToCartButton = ({ onAddToCart, isLoading }) => {
    // Only handles add to cart action
}


const ProductView = ({ product, addToCart }) => {
    const [quantity, setQuantity] = useState(1)
    const [isLoading, setIsLoading] = useState(false)
    
    const handleAddToCart = useCallback(async () => {
        setIsLoading(true)
        try {
            await addToCart({ productId: product.id, quantity })
        } finally {
            setIsLoading(false)
        }
    }, [addToCart, product.id, quantity])
    
    return (
        <Box>
            <QuantityPicker value={quantity} onChange={setQuantity} />
            <AddToCartButton />
        </Box>
    )
}

2. Hook Usage Patterns to manage business logic and data fetching

Hook pattern

export const useCurrentCustomer = () => {
    const customerId = useCustomerId()
    const { isRegistered, isGuest, customerType } = useCustomerType()
    const query = useCustomer(
        { parameters: { customerId } }, 
        { enabled: !!customerId && isRegistered }
    )
    
    return {
        ...query,
        data: {
            ...query.data,
            customerType,
            customerId,
            isRegistered,
            isGuest
        }
    }
}

useCallback for expensive callback. useMemo for expensive data calculation E.g

const SearchComponent = ({ products, filters }) => {
    const [searchResults, setSearchResults] = useState([])
    
    // ✅ useCallback for expensive search operation
    const handleSearch = useCallback((searchTerm) => {
        // Expensive search algorithm
        const results = products.filter(product => {
            // Complex scoring algorithm
            const score = calculateRelevanceScore(product, searchTerm, filters)
            return score > 0.5
        }).sort((a, b) => {
            // Expensive sorting logic
            return calculateRelevanceScore(b, searchTerm, filters) - 
                   calculateRelevanceScore(a, searchTerm, filters)
        })
        
        setSearchResults(results)
    }, [products, filters]) // Dependencies that affect the calculation
    
    return <SearchInput onSearch={handleSearch} />
}

// Bad: useCallback with dependencies that change on every render
const BadExample = ({ user, settings }) => {
    const [data, setData] = useState([])
    
    // ❌ settings object changes on every render, making useCallback useless
    const handleSubmit = useCallback(() => {
        processData(data, settings)
    }, [data, settings])
    
    return <Form onSubmit={handleSubmit} />
}

// Good: Extract stable values or use useMemo for objects
const GoodExample = ({ user, settings }) => {
    const [data, setData] = useState([])
    
    // ✅ Memoize the settings object first
    const memoizedSettings = useMemo(() => settings, [settings.theme, settings.locale])
    
    const handleSubmit = useCallback(() => {
        processData(data, memoizedSettings)
    }, [data, memoizedSettings])
    
    return <Form onSubmit={handleSubmit} />
}

