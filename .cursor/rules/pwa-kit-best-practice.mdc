5. Internationalization

✅ Use React Intl for translations. Either using FormatedMessage or imperative API like intl.formatMessages() for translations in the app. 
https://formatjs.github.io/docs/react-intl/components
https://formatjs.github.io/docs/react-intl/api

Always run npm run build-translations at template directory to extract all messages

import { useIntl, FormattedMessage } from 'react-intl'

const Component = () => {
    const intl = useIntl()
    
    return (
        <div>
            <FormattedMessage 
                id="product.addToCart" 
                defaultMessage="Add to Cart" 
            />
            <Button aria-label={intl.formatMessage({
                id: 'product.addToCart.aria',
                defaultMessage: 'Add {productName} to cart'
