<isinclude template="email/common/header"/>

  <!-- Heading -->
  <tr>
    <td style="padding-bottom:20px;">
      <h1 style="margin:0;font-size:22px;font-weight:600;color:#181818;line-height:1.3;">${Resource.msg('otpVerification.heading', 'email', null)}</h1>
    </td>
  </tr>

  <!-- Instructions -->
  <tr>
    <td style="padding-bottom:32px;">
      <p style="margin:0;font-size:15px;color:#444444;line-height:1.6;">${Resource.msg('otpVerification.instructions', 'email', null)}</p>
    </td>
  </tr>

  <!-- OTP code display -->
  <tr>
    <td style="padding-bottom:32px;">
      <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
        <tr>
          <td style="background-color:#F3F3F3;border:1px solid #E5E5E5;padding:20px;text-align:center;">
            <span style="font-size:32px;font-weight:700;letter-spacing:0.2em;color:#181818;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;">${pdict.token}</span>
          </td>
        </tr>
      </table>
    </td>
  </tr>

  <!-- Disclaimer -->
  <tr>
    <td>
      <p style="margin:0;font-size:12px;color:#747474;line-height:1.5;">${Resource.msg('otpVerification.disclaimer', 'email', null)}</p>
    </td>
  </tr>

<isinclude template="email/common/footer"/>
