<isinclude template="email/common/header"/>

  <!-- Heading -->
  <tr>
    <td style="padding-bottom:20px;">
      <h1 style="margin:0;font-size:22px;font-weight:600;color:#181818;line-height:1.3;">${Resource.msg('passwordResetMagicLink.heading', 'email', null)}</h1>
    </td>
  </tr>

  <!-- Instructions -->
  <tr>
    <td style="padding-bottom:32px;">
      <p style="margin:0;font-size:15px;color:#444444;line-height:1.6;">${Resource.msg('passwordResetMagicLink.instructions', 'email', null)}</p>
    </td>
  </tr>

  <!-- CTA button -->
  <tr>
    <td style="padding-bottom:32px;">
      <table role="presentation" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td style="background-color:#0176D3;">
            <a href="${pdict.magicLink}" style="display:inline-block;padding:14px 32px;font-size:14px;font-weight:600;color:#FFFFFF;text-decoration:none;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;">${Resource.msg('passwordResetMagicLink.buttonText', 'email', null)}</a>
          </td>
        </tr>
      </table>
    </td>
  </tr>

  <!-- Disclaimer -->
  <tr>
    <td style="padding-bottom:16px;">
      <p style="margin:0;font-size:12px;color:#747474;line-height:1.5;">${Resource.msg('passwordResetMagicLink.disclaimer', 'email', null)}</p>
    </td>
  </tr>

  <!-- Copy URL fallback -->
  <tr>
    <td>
      <p style="margin:0;font-size:12px;color:#747474;line-height:1.5;">${Resource.msg('passwordResetMagicLink.copyUrl', 'email', null)}<br>
      <a href="${pdict.magicLink}" style="color:#0176D3 !important;word-break:break-all;text-decoration:underline;"><span style="color:#0176D3 !important;">${pdict.magicLink}</span></a></p>
    </td>
  </tr>

<isinclude template="email/common/footer"/>
