              </table>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="padding-top:28px;border-top:1px solid #E5E5E5;" align="center">
              <p style="margin:0 0 6px;font-size:12px;color:#747474;line-height:1.5;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;">${Resource.msg('email.brandName', 'email', '')}</p>
              <p style="margin:0;font-size:11px;color:#747474;line-height:1.5;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;">&copy; ${new Date().getFullYear()} ${Resource.msg('email.brandName', 'email', '')}. ${Resource.msg('email.allRightsReserved', 'email', 'All rights reserved.')}</p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
