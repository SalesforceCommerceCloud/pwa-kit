{
    "enabled": true,
    "activeDataEnabled": false,
    "commerceAPI": {
        "proxyPath": "/mobify/proxy/api",
        "parameters": {
            "clientId": "<CLIENT_ID>",
            "organizationId": "<ORGANIZATION_ID>",
            "shortCode": "<SHORT_CODE>",
            "siteId": "<SITE_ID>"
        }
    },
    "defaultSite": "<SITE_ID>",
    "einsteinAPI": {
        "host": "https://api.cquotient.com",
        "einsteinId": "<EINSTEIN_ID>",
        "siteId": "<EINSTEIN_SITE_ID>",
        "isProduction": false
    },
    "pages": {
        "Account": true,
        "Cart": true,
        "Checkout": true,
        "CheckoutConfirmation": true,
        "Home": true,
        "Login": true,
        "Registration": true,
        "ResetPassword": true,
        "LoginRedirect": true,
        "ProductDetail": true,
        "ProductList": true,
        "Wishlist": true
    },
    "routes": [
        {
            "page": "Home",
            "path": "/",
            "exact": true
        },
        {
            "page": "Login",
            "path": "/login",
            "exact": true
        },
        {
            "page": "Registration",
            "path": "/registration",
            "exact": true
        },
        {
            "page": "ResetPassword",
            "path": "/reset-password",
            "exact": true
        },
        {
            "page": "Account",
            "path": "/account"
        },
        {
            "page": "Checkout",
            "path": "/checkout",
            "exact": true
        },
        {
            "page": "CheckoutConfirmation",
            "path": "/checkout/confirmation/:orderNo"
        },
        {
            "page": "LoginRedirect",
            "path": "/callback",
            "exact": true
        },
        {
            "page": "Cart",
            "path": "/cart",
            "exact": true
        },
        {
            "page": "ProductDetail",
            "path": "/product/:productId"
        },
        {
            "page": "ProductList",
            "path": "/search"
        },
        {
            "page": "ProductList",
            "path": "/category/:categoryId"
        },
        {
            "page": "Wishlist",
            "path": "/account/wishlist"
        }
    ],
    "siteAliases": {
        "<SITE_ID>": "<ALIAS>"
    },
    "sites": [
        {
            "id": "<SITE_ID>",
            "l10n": {
                "defaultCurrency": "<CURRENCY>",
                "defaultLocale": "<LOCALE>",
                "supportedCurrencies": ["<CURRENCY>"],
                "supportedLocales": [
                    {
                        "id": "<LOCALE>",
                        "preferredCurrency": "<CURRENCY>"
                    }
                ]
            }
        }
    ],
    "url": {
        "site": "path",
        "locale": "path",
        "showDefaults": true,
        "interpretPlusSignAsSpace": false
    }
}
