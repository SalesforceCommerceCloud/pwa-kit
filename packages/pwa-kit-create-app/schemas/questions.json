{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Questions Schema",
    "type": "array",
    "items": {
        "type": "object",
        "required": [
            "name",
            "message"
        ],
        "properties": {
            "name": {
                "type": "string"
            },
            "message": {
                "type": "string"
            },
            "type": {
                "type": "string"
            },
            "choices": {
                "type": "array",
                "items": {
                    "type": "object",
                    "required": [
                        "name",
                        "value"
                    ],
                    "properties": {
                        "name": {
                            "type": "string"
                        },
                        "value": {}
                    }
                }
            }
        },
        "additionalProperties": true
    }
} 